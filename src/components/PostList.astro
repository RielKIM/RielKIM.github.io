---
import { formatDate, readingMinutes, postUrl, type Post } from '../lib/posts';
interface Props { posts: Post[]; }
const { posts } = Astro.props;
---
<div class="post-list">
  {posts.map(post => <article class="post-item">
    <div class="post-meta">
      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      <span class="reading-time">약 {readingMinutes(post)}분</span>
      {post.data.imported && <span class="post-source">이전 글 아카이브</span>}
    </div>
    <h2 class="post-title"><a class="post-title-link" href={postUrl(post)}>{post.data.title}</a></h2>
    <p class="post-description">{post.data.description}</p>
    <div class="post-tags">{post.data.tags.map(tag => <a class="tag" href={`/search/?tag=${encodeURIComponent(tag)}`}>{tag}</a>)}</div>
  </article>)}
</div>
