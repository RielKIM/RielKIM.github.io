---
import Base from '../layouts/Base.astro';
import PostList from './PostList.astro';
import { profile } from '../data/profile';
import { POSTS_PER_PAGE, tagCounts, type Post } from '../lib/posts';
interface Props { posts: Post[]; pageNumber?: number; }
const { posts, pageNumber = 1 } = Astro.props;
const pages = Math.max(1, Math.ceil(posts.length / POSTS_PER_PAGE));
const visible = posts.slice((pageNumber - 1) * POSTS_PER_PAGE, pageNumber * POSTS_PER_PAGE);
const tags = tagCounts(posts);
const pageUrl = (number: number) => number === 1 ? '/' : `/page/${number}/`;
---
<Base title={pageNumber > 1 ? `글 목록 · ${pageNumber}페이지` : undefined}>
  <div class="container">
    <header class="blog-intro">
      <p class="intro-label">YOUNGWOOK KIM / UK.AI</p>
      <h1 class="intro-title">AI와 LLM을 읽고,<br/>이해한 것을 기록합니다.</h1>
      <p class="intro-description">논문에서 배운 개념부터 에이전트와 개발 도구까지.<br/>공부하며 정리한 내용을 이곳에 모읍니다.</p>
      <div class="intro-links"><a href="/about/">소개</a><a href={profile.github}>GitHub ↗</a><a href={profile.linkedin}>LinkedIn ↗</a></div>
    </header>
    <div class="blog-layout">
      <section class="blog-main" aria-labelledby="latest-heading">
        <div class="list-heading"><h2 id="latest-heading">{pageNumber === 1 ? '최근 글' : '이전 글'}</h2><span>{posts.length}편의 기록</span></div>
        {visible.length ? <PostList posts={visible}/> : <p class="section-description">첫 글을 준비하고 있습니다.</p>}
        {pages > 1 && <nav class="pagination" aria-label="글 목록 페이지">
          {pageNumber > 1 && <a href={pageUrl(pageNumber - 1)} aria-label="이전 페이지">←</a>}
          {Array.from({ length: pages }, (_, i) => i + 1).map(number => <a href={pageUrl(number)} aria-label={`${number}페이지`} aria-current={number === pageNumber ? 'page' : undefined}>{number}</a>)}
          {pageNumber < pages && <a href={pageUrl(pageNumber + 1)} aria-label="다음 페이지">→</a>}
        </nav>}
      </section>
      <aside class="blog-sidebar" aria-label="글 탐색">
        <section class="sidebar-section"><h2 class="sidebar-title">주제별로 읽기</h2><ul class="topic-list">{tags.slice(0, 8).map(([tag, count]) => <li><a href={`/search/?tag=${encodeURIComponent(tag)}`}><span>{tag}</span><span>{count}</span></a></li>)}</ul><a class="text-link" href="/search/">모든 주제와 검색 →</a></section>
        <section class="sidebar-section"><h2 class="sidebar-title">흩어진 기록을 한곳에</h2><p class="sidebar-note">브런치와 Velog에서 쓴 글도 함께 모았습니다. 각 글에서 최초 작성일과 원문을 확인할 수 있습니다.</p><div class="source-links"><a href={profile.brunch}>브런치 ↗</a><a href={profile.velog}>Velog ↗</a></div></section>
        <section class="sidebar-section"><h2 class="sidebar-title">새 글 받아보기</h2><p class="sidebar-note">RSS 리더에서 새로운 기록을 구독할 수 있습니다.</p><a class="text-link" href="/rss.xml">RSS 피드 →</a></section>
      </aside>
    </div>
  </div>
</Base>
