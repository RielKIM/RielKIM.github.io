---
import { render } from 'astro:content';
import 'katex/dist/katex.min.css';
import Base from '../../layouts/Base.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { publishedPosts, formatDate, readingMinutes, relatedPosts, postUrl } from '../../lib/posts';
export async function getStaticPaths() {
  return (await publishedPosts()).map(post => ({ params: { id: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter(heading => heading.depth <= 3);
const related = relatedPosts(post, await publishedPosts());
const canonical = post.data.imported ? post.data.sources[0]?.url : undefined;
---
<Base title={post.data.title} description={post.data.description} article published={post.data.date} modified={post.data.updated} canonical={canonical}>
  <div class="container article-shell">
    <article class="article-main">
      <header class="article-header">
        <a class="back-link" href="/">← 전체 글</a>
        <div class="post-meta"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time><span>약 {readingMinutes(post)}분</span>{post.data.updated && <span>수정 {formatDate(post.data.updated)}</span>}</div>
        <h1 class="page-title">{post.data.title}</h1>
        <p class="page-description">{post.data.subtitle || post.data.description}</p>
        <div class="post-tags">{post.data.tags.map(tag => <a class="tag" href={`/search/?tag=${encodeURIComponent(tag)}`}>{tag}</a>)}</div>
      </header>
      {post.data.imported && <aside class="source-notice" aria-label="원문과 이관 안내">
        <p><strong>이전 글 아카이브</strong> · 원래 작성한 시점의 내용을 옮긴 글입니다.</p>
        <p>기술 버전과 수치·주장은 최초 작성 시점을 기준으로 읽어주세요. 이관 과정에서 최신 사실로 다시 검증하거나 갱신하지 않았습니다.</p>
        <div class="source-links">{post.data.sources.map(source => <a href={source.url}>브런치 원문 ↗</a>)}</div>
        {post.data.archiveNote && <p>{post.data.archiveNote}</p>}
      </aside>}
      {toc.length > 1 && <details class="toc-mobile"><summary>이 글의 목차</summary><TableOfContents headings={toc}/></details>}
      <div class:list={['prose', { 'prose--native': !post.data.imported }]}><Content/></div>
      <p class="sr-only" id="copy-status" role="status" aria-live="polite"></p>
      <footer class="article-footer"><a class="text-link" href="/">← 전체 글</a><a class="text-link" href="/rss.xml">RSS로 새 글 받기 →</a></footer>
      {related.length > 0 && <section class="related-posts" aria-labelledby="related-heading"><h2 id="related-heading">이어서 읽기</h2>{related.map(item => <article class="post-item"><p class="post-meta">{formatDate(item.data.date)}</p><h3><a href={postUrl(item)}>{item.data.title}</a></h3></article>)}</section>}
    </article>
    {toc.length > 1 && <aside class="article-toc" aria-label="이 글의 목차"><h2 class="sidebar-title">ON THIS PAGE</h2><TableOfContents headings={toc}/></aside>}
  </div>
  <script>
    const status = document.querySelector<HTMLElement>('#copy-status');
    document.querySelectorAll<HTMLPreElement>('.prose pre').forEach((pre, index) => {
      const code = pre.querySelector('code');
      if (!code) return;
      const button = document.createElement('button');
      button.type = 'button'; button.className = 'code-copy-btn'; button.textContent = '복사';
      button.setAttribute('aria-label', `${index + 1}번째 코드 복사`);
      pre.classList.add('has-copy'); pre.append(button);
      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(code.textContent || '');
          button.textContent = '복사됨';
          if (status) status.textContent = `${index + 1}번째 코드가 복사되었습니다.`;
        } catch {
          button.textContent = '복사 실패';
          if (status) status.textContent = '클립보드 접근이 허용되지 않았습니다. 코드를 직접 선택해 복사해 주세요.';
        }
        setTimeout(() => { button.textContent = '복사'; }, 2000);
      });
    });
  </script>
</Base>
