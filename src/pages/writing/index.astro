---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { publishedPosts } from '../../lib/posts';
const posts = await publishedPosts();
const tags = [...new Set(posts.flatMap(post => post.data.tags))].sort();
---
<Base title="글" description="배운 기술과 프로젝트 과정에 대한 기록."><div class="container"><header class="page-intro"><p class="eyebrow">NOTES TO MY FUTURE SELF</p><h1 class="page-title">배움의 기록<span style="color:var(--accent)">.</span></h1><p class="page-description">정답보다 과정에 집중하는 노트.<br/>기술과 프로젝트를 통해 배운 것을 정리합니다.</p></header>{posts.length ? <><div class="filter-bar" hidden><label class="search-field"><span class="sr-only">글 검색</span><input type="search" placeholder="제목, 내용 소개, 태그로 검색" aria-label="글 검색"/></label><div class="filter-tags" role="group" aria-label="태그 필터"><button type="button" data-tag="" aria-pressed="true">전체</button>{tags.map(tag => <button type="button" data-tag={tag} aria-pressed="false">{tag}</button>)}</div></div><p class="results-count" role="status" aria-live="polite">{posts.length}개의 글</p><PostList posts={posts}/><div class="no-results empty-note" hidden><h2>검색 결과가 없습니다.</h2><p>다른 검색어나 태그를 선택해 주세요.</p></div></> : <div class="empty-note"><div class="note-icon" aria-hidden="true">Aa<span style="color:var(--accent)">.</span></div><p class="section-kicker">STARTING A NEW PAGE</p><h2 class="empty-title">아직 발행한 글이 없습니다.</h2><p class="empty-copy">새로운 기록을 준비하고 있습니다.<br/>먼저 공개된 프로젝트를 살펴보세요.</p><a class="button secondary" href="/projects/">프로젝트 둘러보기 →</a></div>}<section class="contact-strip"><div><p class="section-kicker">KEEP IN THE LOOP</p><h2 class="contact-heading">새로운 글을 RSS로.</h2></div><a class="text-link" href="/rss.xml">RSS 피드 열기 ↗</a></section></div>
<script>
 const bar=document.querySelector<HTMLElement>('.filter-bar');
 if(bar){bar.hidden=false; const input=bar.querySelector<HTMLInputElement>('input'); const buttons=Array.from(bar.querySelectorAll<HTMLButtonElement>('[data-tag]')); const items=Array.from(document.querySelectorAll<HTMLElement>('[data-post]')); let selected='';
 const update=()=>{const query=(input?.value||'').trim().toLocaleLowerCase();let count=0;items.forEach(item=>{const matches=(item.dataset.search||'').toLocaleLowerCase().includes(query)&&(!selected||(JSON.parse(item.dataset.tags||'[]') as string[]).includes(selected));item.hidden=!matches;if(matches)count++;});const status=document.querySelector('.results-count');if(status)status.textContent=`${count}개의 글`;const empty=document.querySelector<HTMLElement>('.no-results');if(empty)empty.hidden=count>0;};
 input?.addEventListener('input',update); buttons.forEach(button=>button.addEventListener('click',()=>{selected=button.dataset.tag||'';buttons.forEach(b=>b.setAttribute('aria-pressed',String(b===button)));update();}));
 }
</script></Base>
