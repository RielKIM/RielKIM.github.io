---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostList from '../components/PostList.astro';
import { profile } from '../data/profile';
import { projects } from '../data/projects';
import { publishedPosts } from '../lib/posts';
const posts = (await publishedPosts()).slice(0,3);
---
<Base><div class="container">
 <section class="hero" aria-labelledby="hero-title"><div class="hero-copy"><p class="eyebrow"><span class="dot"></span> {profile.name} <span aria-hidden="true">/</span> PERSONAL ARCHIVE</p><h1 id="hero-title">만들고, 배우고,<br/><span class="muted-heading">기록합니다.</span></h1><p class="hero-description">{profile.description}<br/>코드 너머의 과정까지, 이곳에 남깁니다.</p><div class="hero-actions"><a class="button primary" href="/projects/">프로젝트 둘러보기 <span aria-hidden="true">↗</span></a><a class="text-link" href="/about/">저를 소개합니다 <span aria-hidden="true">→</span></a></div></div>
 <div class="hero-art" aria-hidden="true"><svg viewBox="0 0 420 360" fill="none"><path d="M45 300H375M55 40v275" stroke="var(--line)" stroke-dasharray="3 5"/><circle cx="226" cy="174" r="126" stroke="var(--line)"/><ellipse cx="226" cy="174" rx="152" ry="68" transform="rotate(-32 226 174)" stroke="var(--accent)" stroke-width="1.2"/><ellipse cx="226" cy="174" rx="68" ry="132" transform="rotate(-32 226 174)" stroke="var(--line)"/><circle cx="226" cy="174" r="67" fill="var(--soft-accent)"/><path d="m208 153-20 21 20 21m36-42 20 21-20 21m-13-49-12 57" stroke="var(--accent)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/><circle cx="340" cy="85" r="9" fill="var(--accent)"/><circle cx="112" cy="260" r="6" fill="var(--ink)"/><rect x="41" y="90" width="88" height="30" rx="15" fill="var(--surface)" stroke="var(--line)"/><text x="85" y="109" text-anchor="middle" fill="var(--muted)" font-size="10" letter-spacing="1.5">EXPLORE</text><rect x="285" y="233" width="96" height="30" rx="15" fill="var(--surface)" stroke="var(--line)"/><text x="333" y="252" text-anchor="middle" fill="var(--muted)" font-size="10" letter-spacing="1.5">ITERATE</text><path d="M365 33v18m-9-9h18M74 222v12m-6-6h12" stroke="var(--muted)"/><text x="185" y="330" fill="var(--muted)" font-size="10" letter-spacing="2">ALWAYS IN PROGRESS</text></svg></div>
 </section>
 <div class="hero-footnote"><span>PROJECTS, THOUGHTS & EVERYTHING BETWEEN.</span><span>SCROLL TO EXPLORE ↓</span></div>
 <section class="section" aria-labelledby="projects-title"><div class="section-heading"><div><p class="section-kicker">01 / PROJECTS</p><h2 class="section-title" id="projects-title">코드로 남긴 것들<span style="color:var(--accent)">.</span></h2><p class="section-description">공개 저장소에서 살펴볼 수 있는 프로젝트입니다.</p></div><a class="text-link" href="/projects/">모든 프로젝트 <span aria-hidden="true">↗</span></a></div><div class="projects-grid">{projects.slice(0,3).map((project,index) => <ProjectCard project={project} index={index}/>)}</div></section>
 <section class="section writing-layout" aria-labelledby="writing-title"><div><p class="section-kicker">02 / WRITING</p><h2 class="section-title" id="writing-title">생각을 정리하는<br/>가장 좋은 방법.</h2><p class="section-description">배운 것과 고민한 것,<br/>그리고 다음에 더 잘하고 싶은 것.</p><a class="text-link" href="/writing/">모든 글 보기 <span aria-hidden="true">↗</span></a></div>{posts.length ? <PostList posts={posts}/> : <div class="empty-note"><div class="note-icon" aria-hidden="true">Aa<span style="color:var(--accent)">.</span></div><p class="section-kicker">A NEW CHAPTER</p><h3 class="empty-title">첫 번째 기록을 준비하고 있습니다.</h3><p class="empty-copy">차근차근 정리한 이야기를 이곳에서 만나보세요.</p><a class="text-link" href={profile.github}>그동안의 코드는 GitHub에서 ↗</a></div>}</section>
 <section class="contact-strip"><div><p class="section-kicker">ELSEWHERE ON THE INTERNET</p><h2 class="contact-heading">다른 곳에서도 만나요.</h2></div><div class="contact-links"><a class="button secondary" href={profile.github}>GitHub ↗</a><a class="button secondary" href={profile.linkedin}>LinkedIn ↗</a></div></section>
</div></Base>
