---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
import { profile } from '../data/profile';
---
<Base title="프로젝트" description="공개 저장소에 기록한 프로젝트와 작은 도구들."><div class="container"><header class="page-intro"><p class="eyebrow">THE THINGS I'VE BUILT</p><h1 class="page-title">프로젝트<span style="color:var(--accent)">.</span></h1><p class="page-description">아이디어를 코드로 옮긴 흔적들.<br/>프로젝트의 자세한 내용은 각 GitHub 저장소에서 확인할 수 있습니다.</p></header><div class="section-heading"><p class="section-kicker">PUBLIC REPOSITORIES / {String(projects.length).padStart(2,'0')}</p><a class="text-link" href={`${profile.github}?tab=repositories`}>GitHub 전체 저장소 ↗</a></div><div class="projects-grid">{projects.map((project,index) => <ProjectCard project={project} index={index}/>)}</div><section class="contact-strip"><h2 class="contact-heading">결과뿐 아니라, 과정까지.</h2><a class="text-link" href="/writing/">기술 글 둘러보기 →</a></section></div></Base>
